# Variables de Docker Compose. Copia este archivo a `.env` (no se versiona) y ajusta lo que necesites:
#   cp .env.example .env
# Todas tienen un valor por defecto: sin `.env` también funciona.

# --- Sitio web ---------------------------------------------------------------------------------
# Puerto del computador desde el que se abre el sitio: http://localhost:8080
WEB_PORT=8080

# Variables VITE_*: se incrustan en el JavaScript al construir la imagen. Son PÚBLICAS: no
# pongas secretos. Si las cambias, reconstruye: `docker compose build web`.
VITE_API_URL=http://localhost:3000
VITE_CLOUDINARY_CLOUD_NAME=meoo7p5s

# --- Base de datos (perfil `db`: docker compose --profile db up) -------------------------------
# PostgreSQL. Estos valores son de DESARROLLO. En producción usa una contraseña propia y larga.
POSTGRES_DB=perija
POSTGRES_USER=perija
POSTGRES_PASSWORD=perija_dev
# Puerto del computador para conectar con un cliente (DBeaver, psql, etc.). Solo escucha en 127.0.0.1.
DB_PORT=5432
